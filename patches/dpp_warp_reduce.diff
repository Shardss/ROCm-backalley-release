+// AMD: DPP-based cross-lane reduction. row_shr within a row of 16 lanes, then
+// permlanex16 / permlane64 across rows. Replaces the generic shuffle loop, which
+// costs log2(width) full cross-lane ops (6 on wave64).
+#if defined(GGML_USE_HIP) && defined(__gfx1100__) || defined(GGML_USE_HIP) && defined(__gfx1101__) || \
+    defined(GGML_USE_HIP) && defined(__gfx1102__) || defined(GGML_USE_HIP) && defined(__gfx1200__) || \
+    defined(GGML_USE_HIP) && defined(__gfx1201__)
+#define GGML_HIP_DPP_REDUCE
+#endif
 
+#ifdef GGML_HIP_DPP_REDUCE
+template<int width>
+static __device__ __forceinline__ int amd_dpp_reduce_add(int x) {
+    // reduce within each group of 16 lanes using row_shr DPP
+    if (width >= 2)  x += __hip_ds_swizzle(x, 0x041F); // xor 1
+    if (width >= 4)  x += __hip_ds_swizzle(x, 0x081F); // xor 2
+    if (width >= 8)  x += __hip_ds_swizzle(x, 0x101F); // xor 4
+    if (width >= 16) x += __hip_ds_swizzle(x, 0x201F); // xor 8
+    if (width >= 32) x += __builtin_amdgcn_permlanex16(x, x, 0xFFFFFFFF, 0xFFFFFFFF, false, false);
+    if (width >= 64) x += __builtin_amdgcn_permlane64(x);
+    return x;
+}
+#endif // GGML_HIP_DPP_REDUCE
