 using namespace ggml_cuda_mma;
 
+// Whether the KQ mask has to be loaded and added for this KV block.
+//
+// ncols2 > 1 implies mask != nullptr (the GQA path requires a mask), so the two forms below are
+// equivalent. They do NOT generate equivalent code, and the better choice differs by vendor:
+//
+//   RDNA (gfx1201, measured): ncols2 is a template parameter, so `ncols2 > 1` folds to a
+//     compile-time true and the mask load becomes unconditional straight-line code. That inflates
+//     the live range and costs ~30 extra VGPRs of spill inside the KV loop at head dim 128
+//     (210 -> 179 spills), worth +9.3% / +14.2% prefill at 8k / 16k of context.
+//   NVIDIA (sm_120, measured): the opposite. Branching on the pointer spills MORE
+//     (12 -> 152 bytes spill stores, 12 -> 608 bytes spill loads), so keep the upstream form.
+//
+// CDNA is untested; it takes the upstream form until someone measures it.
+#if defined(AMD_WMMA_AVAILABLE)
+#define GGML_FATTN_MASK_NEEDED(ncols2, mask_h) ((mask_h) != nullptr)
+#else
+#define GGML_FATTN_MASK_NEEDED(ncols2, mask_h) ((ncols2) > 1 || (mask_h))
+#endif // defined(AMD_WMMA_AVAILABLE)
+
