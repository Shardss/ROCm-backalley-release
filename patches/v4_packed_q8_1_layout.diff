+// Same maths as vec_dot_q3_K_q8_1 above; only the q8_1 activations come from the packed layout.
+// Q3_K touches QR3_K=4 q8_1 blocks per call, one int from each, so each needs its own
+// outer/inner index into the grouped layout.
+template <int q8_1_layout_block_size>
+static __device__ __forceinline__ float vec_dot_q3_K_q8_1_layout(
+        const void * __restrict__ vbq,
+        const block_q8_1_layout<q8_1_layout_block_size> * __restrict__ y_layout,
+        const int & kby,
+        const int & kbx,
+        const int iqs) {
+    static_assert(q8_1_layout_block_size % QK8_1 == 0);
+    constexpr int q8_1_blocks       = block_q8_1_layout<q8_1_layout_block_size>::q8_1_blocks;
+    constexpr int q8_1_qs_per_block = QK8_1 / sizeof(int32_t);
+
+    const block_q3_K * bq3_K = (const block_q3_K *) vbq + kbx;
+
+    const int bq8_offset   = QR3_K * (iqs / (QI3_K/2));
+    const int scale_offset = iqs - iqs % QI8_1 + (iqs % QI8_1) / (QI8_1/2);
+
+    const float d = bq3_K->d;
+
+    const int vl = get_int_b2(bq3_K->qs, iqs);
+    const int vh = ~get_int_b2(bq3_K->hmask, iqs % (QI3_K/2)) >> bq8_offset;
+
+    int    u[QR3_K];
+    float d8[QR3_K];
+
+#pragma unroll
+    for (int i = 0; i < QR3_K; ++i) {
+        const int block_offset = kby + bq8_offset + i;
+        const int block_outer  = block_offset / q8_1_blocks;
+        const int block_inner  = block_offset % q8_1_blocks;
+
+        const block_q8_1_layout<q8_1_layout_block_size> * by = y_layout + block_outer;
+        const int32_t * q8 = by->qs + block_inner * q8_1_qs_per_block;
+
+        u[i]  = q8[iqs % QI8_1];
+        d8[i] = __low2float(by->ds[block_inner]);
+    }
+
+    return vec_dot_q3_K_q8_1_impl_mmvq(vl, vh, u, bq3_K->scales, scale_offset, d, d8);
