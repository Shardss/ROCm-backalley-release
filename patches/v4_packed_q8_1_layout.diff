+// Same maths as vec_dot_iq4_xs_q8_1 above; only the q8_1 activations are read from the packed
+// layout instead of the standard interleaved one. The packed layout stores all scales first and
+// then all quants for a group of blocks, so the 32-byte qs read lands aligned rather than
+// straddling a 36-byte {ds,qs} struct. One q8_1 block per call, matching the standard version -
+// the K-quant packed policy assumes two, which is why IQ4_XS needs its own policy.
+template <int q8_1_layout_block_size>
+static __device__ __forceinline__ float vec_dot_iq4_xs_q8_1_layout(
+        const void * __restrict__ vbq,
+        const block_q8_1_layout<q8_1_layout_block_size> * __restrict__ y_layout,
+        const int & kby,
+        const int & kbx,
+        const int iqs) {
+    static_assert(q8_1_layout_block_size % QK8_1 == 0);
+    constexpr int q8_1_blocks       = block_q8_1_layout<q8_1_layout_block_size>::q8_1_blocks;
+    constexpr int q8_1_qs_per_block = QK8_1 / sizeof(int32_t);
+
+    const block_iq4_xs * bq4 = (const block_iq4_xs *) vbq + kbx;
+
+    const int block_offset = kby + iqs/4;
+    const int block_outer  = block_offset / q8_1_blocks;
+    const int block_inner  = block_offset % q8_1_blocks;
+
+    const block_q8_1_layout<q8_1_layout_block_size> * by = y_layout + block_outer;
+    const int32_t * q8 = by->qs + block_inner * q8_1_qs_per_block;
+
+    int sumi = 0;
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+        const int aux_q4 = get_int_b4(bq4->qs, iqs + j);
+        const int2 v = get_int_from_table_16(aux_q4, kvalues_iq4nl);
+
+        sumi = ggml_cuda_dp4a(v.x, q8[j + 0], sumi);
+        sumi = ggml_cuda_dp4a(v.y, q8[j + 4], sumi);
+    }
+
+    const int ls = ((bq4->scales_l[iqs/8] >> (iqs & 0x04)) & 0x0F) | (((bq4->scales_h >> (iqs/2)) & 0x03) << 4);
+    sumi *= ls - 32;
+
+    const float d = __half2float(bq4->d) * __low2float(by->ds[block_inner]);
+    return d * sumi;
+}
